# Server-only. Never reference these from src/ or expose through VITE_* variables.
# Which provider the server uses: openrouter (default) or gemini
AI_PROVIDER=openrouter

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# images: POST /images (image-only models like FLUX). chat: chat completions (Gemini image models).
OPENROUTER_IMAGE_API=images

# Set to 1 to use the scripted Mock_Gemini (tests and offline demos)
MOCK_GEMINI=
